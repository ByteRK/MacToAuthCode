{
  "name": "auth-code-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "dev": "yarn build:web && node ./node_modules/tsx/dist/cli.mjs watch server/main.ts",
    "build": "yarn typecheck && yarn build:web && yarn build:server",
    "build:web": "node ./node_modules/vite/bin/vite.js build",
    "build:server": "node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "package:standalone": "node tools/build-standalone.mjs",
    "typecheck": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "start": "node --experimental-sqlite dist/server/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "element-plus": "^2.11.4",
    "fastify": "^5.6.1",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "esbuild": "^0.25.11",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
